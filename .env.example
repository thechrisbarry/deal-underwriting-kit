# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Everything in scripts/ works with NO keys. These are only for the paid
# comps layer you add yourself.

# Free, instant — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Free, instant — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Free, instant — https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Your paid comps provider, if you add one
COMPS_API_KEY=
